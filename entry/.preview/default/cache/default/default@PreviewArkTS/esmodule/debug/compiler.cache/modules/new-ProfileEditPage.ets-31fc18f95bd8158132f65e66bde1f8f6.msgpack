                .width('100%').margin({ bottom: 10 })

              ReadOnlyField({ label: 'å­¦å·', value: MOCK_STUDENT.studentId })
              ReadOnlyField({ label: 'å­¦é™¢', value: MOCK_STUDENT.college })
              ReadOnlyField({ label: 'ä¸“ä¸š', value: MOCK_STUDENT.major })
              ReadOnlyField({ label: 'ç­çº§', value: MOCK_STUDENT.className, isLast: true })
            }
            .width('100%').padding(18)
            .backgroundColor('#F8FAFC').borderRadius(12)
            .margin({ left: 14, right: 14, bottom: 14 })

            // å¯ç¼–è¾‘å­—æ®µ
            Column() {
              Text('è”ç³»ä¿¡æ¯').fontSize(11).fontWeight(700).fontColor('#64748B')
                .width('100%').margin({ bottom: 10 })

              EditableField({
                label: 'æ‰‹æœºå·', value: this.phone, placeholder: 'è¯·è¾“å…¥æ‰‹æœºå·',
                errorMsg: this.phoneError,
                onChange: (val: string) => { this.phone = val; this.phoneError = ''; }
