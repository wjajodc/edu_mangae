import { router } from '@kit.ArkUI';
import { TopBar } from '../components/TopBar';
import { LoadingPlaceholder } from '../components/LoadingPlaceholder';
import { EmptyPlaceholder } from '../components/EmptyPlaceholder';
import { ConfirmDialog } from '../components/ConfirmDialog';
import { MOCK_SELECTION_ROUND, MOCK_SELECTABLE_COURSES, MOCK_MY_SELECTIONS } from '../mock/MockData';
import { SelectableCourse, SelectionRound } from '../model/CourseModel';

@Entry
@Component
struct SelectionPage {
  /** é€‰è¯¾è½®æ¬¡ */
  @State round: SelectionRound = MOCK_SELECTION_ROUND;
  /** å¯é€‰è¯¾ç¨‹åˆ—è¡¨ */
  @State selectableCourses: SelectableCourse[] = [];
  /** å·²é€‰è¯¾ç¨‹åˆ—è¡¨ */
  @State mySelections: SelectableCourse[] = [];
  /** å·²é€‰å­¦åˆ† */
  @State selectedCredit: number = 0;
  /** åŠ è½½çŠ¶æ€ */
  @State isLoading: boolean = true;
  /** å½“å‰ Tab */
  @State activeTab: number = 0;
  /** æœç´¢å…³é”®è¯ */
  @State searchKeyword: string = '';
  /** è¯¾ç¨‹ç±»å‹ç­›é€‰ */
  @State filterType: string = 'å…¨éƒ¨';
  /** ç¡®è®¤å¼¹çª— */
  @State showConfirm: boolean = false;
  @State confirmTitle: string = '';
  @State confirmContent: string = '';
  @State pendingCourse: SelectableCourse | null = null;
  /** Toast */
  @State toastMsg: string = '';
  @State showToast: boolean = false;

  aboutToAppear(): void {
    this.loadData();
  }

  private async loadData(): Promise<void> {
    this.isLoading = true;
    await new Promise<void>((r) => setTimeout(r, 500));
    this.selectableCourses = MOCK_SELECTABLE_COURSES.slice();
    this.mySelections = MOCK_MY_SELECTIONS.slice();
    this.selectedCredit = this.mySelections.reduce((sum, c) => sum + c.credit, 0);
    this.isLoading = false;
  }

  /** é€‰è¯¾æ“ä½œ */
  private handleSelect(course: SelectableCourse): void {
    // æ£€æŸ¥æ˜¯å¦å·²åœ¨é€‰è¯¾è½®æ¬¡å†…
    if (!this.round.isActive) {
      this.showToastOnce('å½“å‰ä¸åœ¨é€‰è¯¾è½®æ¬¡æ—¶é—´å†…');
      return;
    }
    // æ£€æŸ¥å­¦åˆ†ä¸Šé™
    if (this.selectedCredit + course.credit > this.round.maxCredit) {
      this.showToastOnce('å­¦åˆ†è¶…é™ï¼Œå½“å‰å·²é€‰ ' + this.selectedCredit + ' å­¦åˆ†');
      return;
    }
    // æ£€æŸ¥äººæ•°å·²æ»¡
    if (course.enrolled >= course.capacity) {
      this.showToastOnce('è¯¥è¯¾ç¨‹é€‰è¯¾äººæ•°å·²æ»¡');
      return;
    }
    // äºŒæ¬¡ç¡®è®¤
    this.pendingCourse = course;
    this.confirmTitle = 'ç¡®è®¤é€‰è¯¾';
    this.confirmContent = `ç¡®å®šè¦é€‰æ‹©ã€Œ${course.courseName}ã€å—ï¼Ÿ`;
    this.showConfirm = true;
  }

  /** ç¡®è®¤é€‰è¯¾ */
  private confirmSelect(): void {
    if (!this.pendingCourse) return;
    const course = this.pendingCourse;
    this.pendingCourse = null;

    // æ¨¡æ‹Ÿå†²çªæ£€æµ‹ï¼ˆéšæœº15%æ¦‚ç‡æ—¶é—´å†²çªï¼‰
    if (Math.random() < 0.15) {
      this.showToastOnce('é€‰è¯¾å¤±è´¥ï¼šä¸å·²æœ‰è¯¾ç¨‹æ—¶é—´å†²çª');
      return;
    }

    // é€‰è¯¾æˆåŠŸ
    course.isSelected = true;
    course.enrolled++;
    this.mySelections.push(this.copyCourse(course));
    this.selectedCredit += course.credit;
    this.refreshList();
    this.showToastOnce('é€‰è¯¾æˆåŠŸ');
  }

  /** é€€é€‰æ“ä½œ */
  private handleDrop(course: SelectableCourse): void {
    if (!this.round.isActive) {
      this.showToastOnce('å½“å‰ä¸åœ¨é€‰è¯¾è½®æ¬¡æ—¶é—´å†…');
      return;
    }
    this.pendingCourse = course;
    this.confirmTitle = 'ç¡®è®¤é€€é€‰';
    this.confirmContent = `ç¡®å®šè¦é€€é€‰ã€Œ${course.courseName}ã€å—ï¼Ÿ`;
    this.showConfirm = true;
  }

  /** ç¡®è®¤é€€é€‰ */
  private confirmDrop(): void {
    if (!this.pendingCourse) return;
    const course = this.pendingCourse;
    this.pendingCourse = null;

    // ä»å·²é€‰åˆ—è¡¨ç§»é™¤
    this.mySelections = this.mySelections.filter(c => c.courseCode !== course.courseCode);
    this.selectedCredit -= course.credit;
    // æ›´æ–°å¯é€‰åˆ—è¡¨çŠ¶æ€
    const idx = this.selectableCourses.findIndex(c => c.courseCode === course.courseCode);
    if (idx >= 0) {
      this.selectableCourses[idx].isSelected = false;
      this.selectableCourses[idx].enrolled--;
    }
    this.refreshList();
    this.showToastOnce('é€€é€‰æˆåŠŸ');
  }

  private refreshList(): void {
    this.selectableCourses = this.selectableCourses.slice();
    this.mySelections = this.mySelections.slice();
  }

  private copyCourse(course: SelectableCourse): SelectableCourse {
    return {
      courseCode: course.courseCode,
      courseName: course.courseName,
      teacher: course.teacher,
      scheduleInfo: course.scheduleInfo,
      capacity: course.capacity,
      enrolled: course.enrolled,
      credit: course.credit,
      courseType: course.courseType,
      isSelected: course.isSelected,
    };
  }

  /** è¿‡æ»¤å¯é€‰è¯¾ç¨‹ */
  private getFilteredCourses(): SelectableCourse[] {
    let list = this.selectableCourses.filter(c => !c.isSelected);
    if (this.filterType !== 'å…¨éƒ¨') {
      list = list.filter(c => c.courseType === this.filterType);
    }
    if (this.searchKeyword.trim()) {
      const kw = this.searchKeyword.trim().toLowerCase();
      list = list.filter(c =>
        c.courseName.toLowerCase().includes(kw) ||
        c.courseCode.toLowerCase().includes(kw) ||
        c.teacher.toLowerCase().includes(kw)
      );
    }
    return list;
  }

  private showToastOnce(msg: string): void {
    this.toastMsg = msg;
    this.showToast = true;
    setTimeout(() => { this.showToast = false; this.toastMsg = ''; }, 2000);
  }

  build() {
    Stack() {
      Column() {
        TopBar({ title: 'é€‰è¯¾', showBack: true, onBack: () => router.back() })

        if (this.isLoading) {
          LoadingPlaceholder()
        } else {
          Column() {
            // é€‰è¯¾è½®æ¬¡ä¿¡æ¯
            this.buildRoundInfo()

            // Tabåˆ‡æ¢
            Row() {
              Text(`å¯é€‰è¯¾ç¨‹ ${this.getFilteredCourses().length}`)
                .fontSize(13).fontWeight(this.activeTab === 0 ? 700 : 500)
                .fontColor(this.activeTab === 0 ? '#2563EB' : '#64748B')
                .padding({ left: 14, right: 14, top: 10, bottom: 10 })
                .borderRadius(8)
                .backgroundColor(this.activeTab === 0 ? '#E8EFFF' : 'transparent')
                .onClick(() => { this.activeTab = 0; })

              Text(`å·²é€‰è¯¾ç¨‹ ${this.mySelections.length}`)
                .fontSize(13).fontWeight(this.activeTab === 1 ? 700 : 500)
                .fontColor(this.activeTab === 1 ? '#2563EB' : '#64748B')
                .padding({ left: 14, right: 14, top: 10, bottom: 10 })
                .borderRadius(8)
                .backgroundColor(this.activeTab === 1 ? '#E8EFFF' : 'transparent')
                .margin({ left: 10 })
                .onClick(() => { this.activeTab = 1; })
            }
            .width('100%')
            .padding({ left: 14, top: 8, bottom: 8 })

            // å†…å®¹åŒºåŸŸ
            if (this.activeTab === 0) {
              this.buildSelectableList()
            } else {
              this.buildMySelectionList()
            }
          }
          .layoutWeight(1)
        }
      }
      .width('100%').height('100%').backgroundColor('#EEF2F8')

      // ç¡®è®¤å¼¹çª—
      ConfirmDialog({
        title: this.confirmTitle,
        content: this.confirmContent,
        visible: $showConfirm,
        onConfirm: () => {
          if (this.confirmTitle === 'ç¡®è®¤é€‰è¯¾') {
            this.confirmSelect();
          } else {
            this.confirmDrop();
          }
        }
      })

      // Toast
      if (this.showToast) {
        Text(this.toastMsg)
          .fontSize(13).fontWeight(500).fontColor('#FFFFFF')
          .padding({ left: 18, right: 18, top: 10, bottom: 10 })
          .borderRadius(999).backgroundColor('rgba(15, 23, 42, 0.88)')
          .position({ bottom: 100, left: '50%' }).translate({ x: '-50%' })
      }
    }
  }

  @Builder
  buildRoundInfo(): void {
    Column() {
      Row() {
        Column() {
          Text(`é€‰è¯¾è½®æ¬¡ï¼š${this.round.roundName}`)
            .fontSize(14).fontWeight(FontWeight.Medium).fontColor('#0F172A')
          Text(`${this.round.startTime} ~ ${this.round.endTime}`)
            .fontSize(11).fontColor('#64748B').margin({ top: 2 })
        }
        .alignItems(HorizontalAlign.Start).layoutWeight(1)

        Text(`å·²é€‰ ${this.selectedCredit}/${this.round.maxCredit} å­¦åˆ†`)
          .fontSize(13).fontWeight(600).fontColor('#2563EB')
          .padding({ left: 10, right: 10, top: 6, bottom: 6 })
          .borderRadius(8).backgroundColor('#E8EFFF')
      }
      .width('100%')

      // æœç´¢æ¡†
      if (this.activeTab === 0) {
        Row() {
          TextInput({ placeholder: 'æœç´¢è¯¾ç¨‹å/è¯¾å·/æ•™å¸ˆ', text: this.searchKeyword })
            .fontSize(13).height(38).layoutWeight(1).backgroundColor('#F8FAFC')
            .borderRadius(8).padding({ left: 10 })
            .onChange((val: string) => { this.searchKeyword = val; })

          ForEach(['å…¨éƒ¨', 'ä¸“ä¸šæ ¸å¿ƒ', 'ä¸“ä¸šæ‹“å±•', 'ä¸“ä¸šé€‰ä¿®'], (t: string) => {
            Text(t === 'ä¸“ä¸šæ ¸å¿ƒ' ? 'æ ¸å¿ƒ' : t === 'ä¸“ä¸šæ‹“å±•' ? 'æ‹“å±•' : t === 'ä¸“ä¸šé€‰ä¿®' ? 'é€‰ä¿®' : t)
              .fontSize(11).fontWeight(600)
              .fontColor(this.filterType === t ? '#FFFFFF' : '#64748B')
              .padding({ left: 8, right: 8, top: 4, bottom: 4 })
              .borderRadius(6)
              .backgroundColor(this.filterType === t ? '#2563EB' : '#F1F5F9')
              .margin({ left: 6 })
              .onClick(() => { this.filterType = t; })
          })
        }
        .width('100%').margin({ top: 10 })
      }
    }
    .width('100%')
    .padding(14)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .margin({ left: 14, right: 14, top: 12 })
  }

  @Builder
  buildSelectableList(): void {
    if (this.getFilteredCourses().length === 0) {
      EmptyPlaceholder({ message: 'æš‚æ— ç¬¦åˆæ¡ä»¶çš„è¯¾ç¨‹', subMessage: 'è¯·è°ƒæ•´ç­›é€‰æ¡ä»¶', iconText: 'ğŸ“‹' })
    } else {
      Scroll() {
        Column() {
          ForEach(this.getFilteredCourses(), (course: SelectableCourse) => {
            SelectionCourseCard({
              course: course,
              isSelectMode: true,
              onAction: () => this.handleSelect(course)
            })
          })
          Column().height(16)
        }.width('100%').padding({ left: 14, right: 14 })
      }
      .scrollBar(BarState.Off).layoutWeight(1)
    }
  }

  @Builder
  buildMySelectionList(): void {
    if (this.mySelections.length === 0) {
      EmptyPlaceholder({ message: 'æš‚æ— å·²é€‰è¯¾ç¨‹', subMessage: 'è¯·åœ¨å¯é€‰è¯¾ç¨‹ä¸­é€‰æ‹©', iconText: 'ğŸ“‹' })
    } else {
      Scroll() {
        Column() {
          ForEach(this.mySelections, (course: SelectableCourse) => {
            SelectionCourseCard({
              course: course,
              isSelectMode: false,
              onAction: () => this.handleDrop(course)
            })
          })
          Column().height(16)
        }.width('100%').padding({ left: 14, right: 14 })
      }
      .scrollBar(BarState.Off).layoutWeight(1)
    }
  }
}

/**
 * é€‰è¯¾è¯¾ç¨‹å¡ç‰‡
 */
@Component
struct SelectionCourseCard {
  @Prop course: SelectableCourse;
  @Prop isSelectMode: boolean = true;
  onAction?: () => void;

  build() {
    Column() {
      Row() {
        Column() {
          Text(this.course.courseName)
            .fontSize(15).fontWeight(FontWeight.Medium).fontColor('#0F172A').maxLines(1)
          Text(this.course.courseCode)
            .fontSize(12).fontColor('#64748B').margin({ top: 2 })
          Text(`æ•™å¸ˆï¼š${this.course.teacher} Â· ${this.course.scheduleInfo}`)
            .fontSize(11).fontColor('#94A3B8').margin({ top: 2 }).maxLines(1)
        }
        .alignItems(HorizontalAlign.Start).layoutWeight(1)

        Column() {
          Text(`${this.course.credit} å­¦åˆ†`)
            .fontSize(13).fontWeight(600).fontColor('#2563EB')
          Text(`${this.course.enrolled}/${this.course.capacity}`)
            .fontSize(11)
            .fontColor(this.course.enrolled >= this.course.capacity ? '#DC2626' : '#64748B')
            .margin({ top: 4 })
        }
        .alignItems(HorizontalAlign.End)
      }
      .width('100%')

      // æ“ä½œæŒ‰é’®
      Row() {
        // è¯¾ç¨‹ç±»å‹æ ‡ç­¾
        Text(this.course.courseType)
          .fontSize(10).fontWeight(600).fontColor('#3730A3')
          .padding({ left: 8, right: 8, top: 2, bottom: 2 })
          .borderRadius(4).backgroundColor('#E0E7FF')

        Blank()

        if (this.isSelectMode) {
          Button(this.course.enrolled >= this.course.capacity ? 'å·²æ»¡' : 'é€‰è¯¾')
            .type(ButtonType.Normal)
            .fontSize(12).fontWeight(600)
            .fontColor(this.course.enrolled >= this.course.capacity ? '#94A3B8' : '#FFFFFF')
            .backgroundColor(this.course.enrolled >= this.course.capacity ? '#F1F5F9' : '#2563EB')
            .borderRadius(8)
            .padding({ left: 14, right: 14, top: 6, bottom: 6 })
            .enabled(this.course.enrolled < this.course.capacity)
            .onClick(() => { if (this.onAction) this.onAction(); })
        } else {
          Button('é€€é€‰')
            .type(ButtonType.Normal)
            .fontSize(12).fontWeight(600).fontColor('#DC2626')
            .backgroundColor('#FEF2F2').borderRadius(8)
            .padding({ left: 14, right: 14, top: 6, bottom: 6 })
            .onClick(() => { if (this.onAction) this.onAction(); })
        }
      }
      .width('100%')
      .margin({ top: 10 })
    }
    .width('100%')
    .padding(14)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .margin({ bottom: 10 })
  }
}
