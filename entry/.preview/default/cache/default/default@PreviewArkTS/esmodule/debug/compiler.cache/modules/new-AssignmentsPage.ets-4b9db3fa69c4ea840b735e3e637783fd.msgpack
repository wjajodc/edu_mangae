  private filters: string[] = ['å…¨éƒ¨', 'æœªæäº¤', 'å·²æäº¤', 'å·²æ‰¹æ”¹'];

  aboutToAppear(): void {
    this.loadData();
  }

  private async loadData(): Promise<void> {
    this.isLoading = true;
    await new Promise<void>((r) => setTimeout(r, 400));
    this.assignments = MOCK_ASSIGNMENTS.slice();
    this.isLoading = false;
  }

  /** è¿‡æ»¤ä½œä¸šåˆ—è¡¨ */
  private getFilteredList(): AssignmentItem[] {
    if (this.activeFilter === 'å…¨éƒ¨') return this.assignments;
    return this.assignments.filter(a => a.status === this.activeFilter);
  }

  build() {
    Stack() {
      Column() {
        TopBar({ title: 'ä½œä¸š/å®žéªŒ', showBack: true, onBack: () => router.back() })

        if (this.isLoading) {
          LoadingPlaceholder()
        } else {
          Column() {
            // çŠ¶æ€ç­›é€‰
            Scroll() {
              Row() {
                ForEach(this.filters, (f: string) => {
                  Text(f)
                    .fontSize(12)
                    .fontWeight(600)
                    .fontColor(this.activeFilter === f ? '#FFFFFF' : '#2563EB')
                    .backgroundColor(this.activeFilter === f ? '#2563EB' : '#FFFFFF')
                    .borderRadius(8)
                    .borderWidth(1)
                    .borderColor('#2563EB')
                    .padding({ left: 12, right: 12, top: 6, bottom: 6 })
                    .margin({ right: 8 })
                    .onClick(() => { this.activeFilter = f; })
                })
              }
            }
            .scrollable(ScrollDirection.Horizontal)
            .scrollBar(BarState.Off)
            .width('100%')
            .padding({ left: 14, top: 12, bottom: 8 })

            // ä½œä¸šåˆ—è¡¨
            if (this.getFilteredList().length === 0) {
              EmptyPlaceholder({ message: 'æš‚æ— ä½œä¸š', iconText: 'ðŸ“' })
            } else {
              Scroll() {
                Column() {
                  ForEach(this.getFilteredList(), (item: AssignmentItem) => {
                    AssignmentCard({
                      item: item,
                      onTap: () => {
                        this.detailItem = item;
                        this.showDetail = true;
                      }
                    })
                  })
                  Column().height(16)
                }
                .width('100%')
                .padding({ left: 14, right: 14 })
              }
              .width('100%')
              .layoutWeight(1)
              .scrollBar(BarState.Off)
            }
          }
          .layoutWeight(1)
        }
      }
      .width('100%')
      .height('100%')
      .backgroundColor('#EEF2F8')

      // ä½œä¸šè¯¦æƒ… + æäº¤å¼¹çª—
      if (this.showDetail && this.detailItem) {
        this.buildDetailSheet()
      }

      if (this.showToast) {
        Text(this.toastMsg)
          .fontSize(13).fontWeight(500).fontColor('#FFFFFF')
          .padding({ left: 18, right: 18, top: 10, bottom: 10 })
          .borderRadius(999).backgroundColor('rgba(15, 23, 42, 0.88)')
          .position({ bottom: 100, left: '50%' }).translate({ x: '-50%' })
      }
    }
  }

  @Builder
  buildDetailSheet(): void {
    Column() {
      Column()
        .width('100%')
        .layoutWeight(1)
        .backgroundColor('rgba(15, 23, 42, 0.45)')
        .onClick(() => { this.showDetail = false; })

      Column() {
        Row() {
          Text('ä½œä¸šè¯¦æƒ…')
            .fontSize(17)
            .fontWeight(FontWeight.Bold)
          Blank()
          Text('âœ•')
            .fontSize(18)
            .fontColor('#64748B')
            .onClick(() => { this.showDetail = false; })
        }
        .width('100%')
        .margin({ bottom: 16 })

        if (this.detailItem) {
          Column() {
            DetailRow({ label: 'ä½œä¸šæ ‡é¢˜', value: this.detailItem.title })
            DetailRow({ label: 'è¯¾ç¨‹', value: this.detailItem.courseName })
            DetailRow({ label: 'æˆªæ­¢æ—¶é—´', value: this.detailItem.deadline })
            DetailRow({ label: 'çŠ¶æ€', value: this.detailItem.status })
            if (this.detailItem.score !== undefined && this.detailItem.score !== null) {
              DetailRow({ label: 'å¾—åˆ†', value: String(this.detailItem.score) })
            }
          }
          .width('100%')
          .margin({ bottom: 16 })

          // æäº¤åŒºåŸŸï¼ˆæœªæäº¤/å·²æäº¤æœªæ‰¹æ”¹å¯é‡æ–°æäº¤ï¼‰
          if (this.detailItem.status === 'æœªæäº¤' || this.detailItem.status === 'å·²æäº¤') {
            Text('æäº¤å†…å®¹').fontSize(13).fontWeight(600).fontColor('#0F172A').width('100%').margin({ bottom: 6 })
            TextArea({ placeholder: 'è¾“å…¥ä½œä¸šå†…å®¹æˆ–è¯´æ˜Ž...', text: this.submitContent })
              .width('100%').height(100).fontSize(13)
              .backgroundColor('#F8FAFC').borderRadius(8).padding(10)
              .onChange((val: string) => { this.submitContent = val; })

            CommonButton({
              label: this.isSubmitting ? 'æäº¤ä¸­...' : 'æäº¤ä½œä¸š',
              block: true, marginTop: 16,
              disabled: this.isSubmitting, loading: this.isSubmitting,
              onTap: () => this.handleSubmitAssignment()
            })
          }
        }
      }
      .width('100%')
      .padding(24)
      .backgroundColor('#FFFFFF')
      .borderRadius({ topLeft: 18, topRight: 18 })
    }
    .width('100%').height('100%').position({ x: 0, y: 0 }).zIndex(50)
  }

  private handleSubmitAssignment(): void {
    if (!this.submitContent.trim()) {
      this.showToastOnce('è¯·è¾“å…¥æäº¤å†…å®¹');
      return;
    }
    this.isSubmitting = true;
    setTimeout(() => {
      this.isSubmitting = false;
      if (this.detailItem) {
        this.detailItem.status = 'å·²æäº¤';
      }
      this.showToastOnce('ä½œä¸šæäº¤æˆåŠŸ');
      this.showDetail = false;
    }, 800);
  }

  private showToastOnce(msg: string): void {
    this.toastMsg = msg; this.showToast = true;
    setTimeout(() => { this.showToast = false; }, 2000);
  }
}

