              this.studentIdError = '';
            })

          if (this.studentIdError) {
            Text(this.studentIdError)
              .fontSize(11)
              .fontColor('#DC2626')
              .margin({ top: 4 })
          }
        }
        .width('100%')
        .margin({ bottom: 18 })

        // å¯†ç è¾“å…¥æ¡†
        Column() {
          Text('å¯†ç ')
            .fontSize(12)
            .fontWeight(600)
            .fontColor('#64748B')
            .margin({ bottom: 6 })

          TextInput({ text: this.password, placeholder: 'è¯·è¾“å…¥å¯†ç ' })
            .type(InputType.Password)
            .width('100%')
            .height(50)
            .fontSize(16)
            .backgroundColor('#F8FAFC')
            .borderRadius(10)
            .borderWidth(1)
            .borderColor(this.passwordError ? '#DC2626' : '#E2E8F0')
            .padding({ left: 16, right: 16 })
            .maxLength(20)
            .onChange((value: string) => {
              this.password = value;
              this.passwordError = '';
            })

          if (this.passwordError) {
            Text(this.passwordError)
              .fontSize(11)
              .fontColor('#DC2626')
              .margin({ top: 4 })
          }
        }
        .width('100%')
        .margin({ bottom: 28 })

        // ç™»å½•æŒ‰é’®
        CommonButton({
          label: this.isLoading ? 'ç™»å½•ä¸­...' : 'ç™» å½•',
          block: true,
          disabled: this.isLoading,
          loading: this.isLoading,
          onTap: () => this.handleLogin(),
        })

        // å¿˜è®°å¯†ç é“¾æ¥
        Row() {
          Text('å¿˜è®°å¯†ç ï¼Ÿ')
            .fontSize(13)
            .fontColor('#2563EB')
            .onClick(() => {
              router.pushUrl({ url: 'pages/ForgetPasswordPage' });
            })
        }
        .width('100%')
        .justifyContent(FlexAlign.Center)
        .margin({ top: 16 })

        // æµ‹è¯•æç¤º
        Text('æµ‹è¯•å­¦å·: 2024316020318')
          .fontSize(11)
          .fontColor('#94A3B8')
          .margin({ top: 20 })
      }
      .width('100%')
      .padding({ left: 28, right: 28 })
      .layoutWeight(1)
      .alignItems(HorizontalAlign.Center)
      }
      .width('100%')
      .height('100%')
      .backgroundColor('#EEF2F8')

      if (this.showToast) {
        Text(this.toastMsg)
          .fontSize(13)
          .fontWeight(500)
          .fontColor('#FFFFFF')
          .padding({ left: 18, right: 18, top: 10, bottom: 10 })
          .borderRadius(999)
          .backgroundColor('rgba(15, 23, 42, 0.88)')
          .maxLines(2)
          .textAlign(TextAlign.Center)
          .position({ bottom: 100, left: '50%' })
          .translate({ x: '-50%' })
      }
    }
    .width('100%')
    .height('100%')
  }

  /**
   * ç™»å½•é€»è¾‘
   * æ ¡éªŒå­¦å·å’Œå¯†ç ï¼Œæ¨¡æ‹Ÿå¼‚æ­¥ç™»å½•è¯·æ±‚
   */
  private handleLogin(): void {
    // è¡¨å•æ ¡éªŒ
    let hasError: boolean = false;

    if (!this.studentId || this.studentId.trim().length === 0) {
      this.studentIdError = 'è¯·è¾“å…¥å­¦å·';
      hasError = true;
    }

    if (!this.password || this.password.trim().length === 0) {
      this.passwordError = 'è¯·è¾“å…¥å¯†ç ';
      hasError = true;
    }

    if (hasError) {
      return;
    }

    // å¼€å§‹ç™»å½•
    this.isLoading = true;

    // æ¨¡æ‹Ÿå¼‚æ­¥ç™»å½•è¯·æ±‚ï¼ˆ1ç§’å»¶è¿Ÿï¼‰
    setTimeout(() => {
      // éªŒè¯å­¦å·
      if (!isValidStudentId(this.studentId)) {
        this.studentIdError = 'è´¦å·æˆ–å¯†ç é”™è¯¯';
        this.showToastOnce('è´¦å·æˆ–å¯†ç é”™è¯¯');
        this.isLoading = false;
        return;
      }

      // ç™»å½•æˆåŠŸ - å†™å…¥å…¨å±€çŠ¶æ€
      const student = MOCK_STUDENT;
      AppStorage.setOrCreate('isLoggedIn', true);
      AppStorage.setOrCreate('studentId', student.studentId);
      AppStorage.setOrCreate('studentName', student.name);
      AppStorage.setOrCreate('avatarInitial', 'æ—');
      AppStorage.setOrCreate('currentSemester', '2025-2026 ç¬¬1å­¦æœŸ');
      syncCurrentTeachingWeek();

      this.isLoading = false;
      this.showToastOnce('ç™»å½•æˆåŠŸ');

      // è·³è½¬ä¸»é¡µé¢
      setTimeout(() => {
        router.replaceUrl({ url: 'pages/MainPage' });
      }, 300);
    }, 1000);
  }

  /**
   * æ˜¾ç¤º Toastï¼ˆä»…è§¦å‘ä¸€æ¬¡ï¼‰
   */
  private showToastOnce(msg: string): void {
    this.toastMsg = msg;
    this.showToast = true;
    setTimeout(() => {
      this.showToast = false;
      this.toastMsg = '';
    }, 2000);
  }
}
