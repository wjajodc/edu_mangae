                onTap: () => { this.showLogoutConfirm = true; },
              },
            ])
            this.buildFooter()
            Column().height(24)
          }
          .width('100%')
        }
        .width('100%')
        .layoutWeight(1)
        .scrollBar(BarState.Off)
      }
      .width('100%')
      .height('100%')
      .backgroundColor('#F2F2F2')

      ConfirmDialog({
        title: 'é€€å‡ºç™»å½•',
        content: 'ç¡®å®šè¦é€€å‡ºç™»å½•å—ï¼Ÿé€€å‡ºåéœ€è¦é‡æ–°è¾“å…¥å­¦å·å’Œå¯†ç ã€‚',
        confirmText: 'é€€å‡º',
        cancelText: 'å–æ¶ˆ',
        visible: $showLogoutConfirm,
        onConfirm: () => this.handleLogout(),
      })
    }
  }

  @Builder
  buildHeader(): void {
    Row() {
      Row().width(40).height(40)
      Text('æˆ‘çš„')
        .fontSize(17)
        .fontWeight(FontWeight.Medium)
        .fontColor('#1A1A1A')
        .layoutWeight(1)
        .textAlign(TextAlign.Center)
      Text('âŠ')
        .fontSize(18)
        .fontColor('#BBBBBB')
        .width(40)
        .height(40)
        .textAlign(TextAlign.Center)
    }
    .width('100%')
    .height(48)
    .padding({ left: 8, right: 8 })
    .backgroundColor('#FFFFFF')
  }

  @Builder
  buildProfileRow(): void {
    Row() {
      Column() {
        Text(this.getAvatarInitial())
          .fontSize(22)
          .fontWeight(FontWeight.Medium)
          .fontColor('#FFFFFF')
      }
      .width(52)
      .height(52)
      .borderRadius(26)
      .backgroundColor('#4A90E2')
      .justifyContent(FlexAlign.Center)
      .alignItems(HorizontalAlign.Center)

      Text(this.studentName || 'åŒå­¦')
        .fontSize(16)
        .fontColor('#1A1A1A')
        .layoutWeight(1)
        .margin({ left: 14 })

      Text('â€º')
        .fontSize(20)
        .fontColor('#CCCCCC')
    }
    .width('100%')
    .padding({ left: 16, right: 16, top: 18, bottom: 18 })
    .backgroundColor('#FFFFFF')
    .margin({ top: 10 })
    .onClick(() => {
      router.pushUrl({ url: 'pages/ProfileEditPage' });
    })
  }

  @Builder
  buildMenuGroup(items: MineMenuItem[]): void {
    Column() {
      ForEach(items, (item: MineMenuItem, index: number) => {
        MineMenuRow({
          title: item.title,
          icon: item.icon,
          iconBg: item.iconBg,
          showDivider: index < items.length - 1,
          onTap: item.onTap,
        })
      }, (item: MineMenuItem, index: number) => `${item.title}_${index}`)
    }
    .width('100%')
    .backgroundColor('#FFFFFF')
    .margin({ top: 10 })
  }

  @Builder
  buildFooter(): void {
    Column() {
      Text('æ•™å­¦ç®¡ç†ç³»ç»Ÿ Â· å­¦ç”Ÿç«¯')
        .fontSize(11)
        .fontColor('#BBBBBB')
        .margin({ bottom: 4 })
      Text(`å­¦å· ${this.studentId || 'â€”'}`)
        .fontSize(11)
        .fontColor('#CCCCCC')
    }
    .width('100%')
    .padding({ top: 20, bottom: 8 })
    .alignItems(HorizontalAlign.Center)
  }

  private handleLogout(): void {
    AppStorage.setOrCreate('isLoggedIn', false);
    AppStorage.setOrCreate('studentId', '');
    AppStorage.setOrCreate('studentName', '');
    router.replaceUrl({ url: 'pages/LoginPage' });
  }
}

@Component
struct MineMenuRow {
  @Prop title: string = '';
  @Prop icon: string = '';
  @Prop iconBg: string = '#F5F5F5';
  @Prop showDivider: boolean = true;
  onTap?: () => void;

  build() {
    Column() {
      Row() {
        Column() {
          Text(this.icon)
            .fontSize(18)
        }
        .width(32)
        .height(32)
        .borderRadius(8)
        .backgroundColor(this.iconBg)
        .justifyContent(FlexAlign.Center)
        .alignItems(HorizontalAlign.Center)

        Text(this.title)
          .fontSize(15)
          .fontColor(this.title === 'é€€å‡ºç™»å½•' ? '#E53935' : '#1A1A1A')
          .layoutWeight(1)
          .margin({ left: 12 })

        Text('â€º')
          .fontSize(20)
          .fontColor('#CCCCCC')
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 14, bottom: 14 })

      if (this.showDivider) {
        Row()
          .width('100%')
          .height(0.5)
          .backgroundColor('#F0F0F0')
          .margin({ left: 60 })
      }
    }
    .width('100%')
    .onClick(() => {
      if (this.onTap) {
        this.onTap();
      }
    })
  }
}
