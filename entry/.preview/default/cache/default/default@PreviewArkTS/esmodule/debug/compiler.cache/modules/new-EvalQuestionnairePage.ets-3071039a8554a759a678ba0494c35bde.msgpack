     */
    handleSubmit() {
        // æ ¡éªŒæœªå®Œæˆé¡¹
        const unanswered = this.questions.filter((q) => {
            if (q.type === 'single' || q.type === 'star') {
                return q.answer === null || q.answer === undefined || q.answer === '';
            }
            if (q.type === 'multi') {
                const multiAnswer = q.answer;
                return !multiAnswer || multiAnswer.length === 0;
            }
            if (q.type === 'text') {
                const textAnswer = q.answer;
                return !textAnswer || textAnswer.trim().length === 0;
            }
            return false;
        });
        if (unanswered.length > 0) {
            // æç¤ºæœªå®Œæˆ
            const firstUnanswered = unanswered[0];
            if (firstUnanswered) {
                const idx = this.questions.findIndex(q => q.id === firstUnanswered.id);
                // æ»šåŠ¨åˆ°æœªå®Œæˆçš„é¢˜ç›®ï¼ˆç®€åŒ–ï¼šå¼¹æç¤ºï¼‰
                // å®é™…å¯ç»“åˆ Scroll ç»„ä»¶æ»šåŠ¨
            }
            return;
        }
        this.isSubmitting = true;
        setTimeout(() => {
            this.isSubmitting = false;
            this.showSuccess = true;
        }, 800);
    }
    rerender() {
        this.updateDirtyElements();
    }
    static getEntryName() {
        return "EvalQuestionnairePage";
    }
