import { router } from '@kit.ArkUI';
import { TopBar } from '../components/TopBar';
import { CommonButton } from '../components/CommonButton';
import { MOCK_EVAL_QUESTIONS } from '../mock/MockData';
import { EvaluationOption, EvaluationQuestion } from '../model/EvalModel';

@Entry
@Component
export struct EvalQuestionnairePage {
  /** é—®å·é¢˜ç›®åˆ—è¡¨ */
  @State questions: EvaluationQuestion[] = [];
  @State isSubmitting: boolean = false;
  @State showSuccess: boolean = false;
  @State taskId: string = '';

  aboutToAppear(): void {
    // ä»è·¯ç”±å‚æ•°è·å– taskId
    const params = router.getParams() as Record<string, string>;
    if (params && params['taskId']) {
      this.taskId = params['taskId'];
    }
    this.loadQuestions();
  }

  private async loadQuestions(): Promise<void> {
    await new Promise<void>((r) => setTimeout(r, 300));
    this.questions = MOCK_EVAL_QUESTIONS.slice();
  }

  build() {
    Stack() {
      Column() {
        TopBar({ title: 'è¯„æ•™é—®å·', showBack: true, onBack: () => router.back() })

        if (this.questions.length === 0) {
          Column() {
            Text('åŠ è½½ä¸­...').fontSize(14).fontColor('#64748B')
          }
          .width('100%').layoutWeight(1).justifyContent(FlexAlign.Center)
        } else {
          Scroll() {
            Column() {
              ForEach(this.questions, (q: EvaluationQuestion, idx: number) => {
                QuestionCard({ question: q, index: idx + 1 })
              })

              // æäº¤æŒ‰é’®
              CommonButton({
                label: this.isSubmitting ? 'æäº¤ä¸­...' : 'æäº¤è¯„æ•™',
                block: true,
                disabled: this.isSubmitting,
                loading: this.isSubmitting,
                onTap: () => this.handleSubmit()
              })

              Column().height(24)
            }
            .width('100%')
            .padding({ left: 14, right: 14, top: 14 })
          }
          .width('100%')
          .layoutWeight(1)
          .scrollBar(BarState.Off)
        }
      }
      .width('100%')
      .height('100%')
      .backgroundColor('#EEF2F8')

      // æäº¤æˆåŠŸå¼¹çª—
      if (this.showSuccess) {
        Column() {
          Column()
            .width('100%')
            .layoutWeight(1)
            .backgroundColor('rgba(15, 23, 42, 0.45)')
            .onClick(() => {})

          Column() {
            Text('âœ…')
              .fontSize(48)
              .margin({ bottom: 12 })
            Text('æäº¤æˆåŠŸ')
              .fontSize(18)
              .fontWeight(FontWeight.Bold)
              .fontColor('#0F172A')
              .margin({ bottom: 8 })
            Text('æ„Ÿè°¢æ‚¨çš„è¯„æ•™ï¼Œæ‚¨çš„æ„è§å¯¹æˆ‘ä»¬å¾ˆé‡è¦ï¼')
              .fontSize(13)
              .fontColor('#64748B')
              .margin({ bottom: 20 })

            Button('è¿”å›')
              .type(ButtonType.Normal)
              .width('100%')
              .height(44)
              .fontSize(15)
              .fontWeight(FontWeight.Medium)
              .fontColor('#FFFFFF')
              .backgroundColor('#2563EB')
              .borderRadius(10)
              .onClick(() => {
                this.showSuccess = false;
                router.back();
              })
          }
          .width('80%')
          .padding(24)
          .backgroundColor('#FFFFFF')
          .borderRadius(16)
          .position({ bottom: 120, left: '10%' })
        }
        .width('100%')
        .height('100%')
        .position({ x: 0, y: 0 })
        .zIndex(50)
      }
    }
  }

  /**
   * æäº¤è¯„æ•™
   * æ ¡éªŒæ‰€æœ‰é¢˜ç›®æ˜¯å¦å·²ä½œç­”
   */
  private handleSubmit(): void {
    // æ ¡éªŒæœªå®Œæˆé¡¹
    const unanswered = this.questions.filter((q: EvaluationQuestion) => {
      if (q.type === 'single' || q.type === 'star') {
        return q.answer === null || q.answer === undefined || q.answer === '';
      }
      if (q.type === 'multi') {
        const multiAnswer = q.answer as string[];
        return !multiAnswer || multiAnswer.length === 0;
      }
      if (q.type === 'text') {
        const textAnswer = q.answer as string;
        return !textAnswer || textAnswer.trim().length === 0;
      }
      return false;
    });

    if (unanswered.length > 0) {
      // æç¤ºæœªå®Œæˆ
      const firstUnanswered = unanswered[0];
      if (firstUnanswered) {
        const idx = this.questions.findIndex(q => q.id === firstUnanswered.id);
        // æ»šåŠ¨åˆ°æœªå®Œæˆçš„é¢˜ç›®ï¼ˆç®€åŒ–ï¼šå¼¹æç¤ºï¼‰
        // å®é™…å¯ç»“åˆ Scroll ç»„ä»¶æ»šåŠ¨
      }
      return;
    }

    this.isSubmitting = true;
    setTimeout(() => {
      this.isSubmitting = false;
      this.showSuccess = true;
    }, 800);
  }
}

/**
 * é—®å·é¢˜ç›®å¡ç‰‡å­ç»„ä»¶
 */
@Component
struct QuestionCard {
  @Prop question: EvaluationQuestion;
  @Prop index: number = 1;

  build() {
    Column() {
      // é¢˜ç›®æ ‡é¢˜
      Row() {
        Text(`${this.index}. ${this.question.title}`)
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor('#0F172A')
          .layoutWeight(1)

        if (this.question.required) {
          Text('*')
            .fontSize(14)
            .fontColor('#DC2626')
        }
      }
      .width('100%')
      .margin({ bottom: 10 })

      // æ ¹æ®é¢˜å‹æ¸²æŸ“
      if (this.question.type === 'single') {
        this.buildSingleQuestion()
      } else if (this.question.type === 'multi') {
        this.buildMultiQuestion()
      } else if (this.question.type === 'star') {
        this.buildStarQuestion()
      } else if (this.question.type === 'text') {
        this.buildTextQuestion()
      }
    }
    .width('100%')
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .margin({ bottom: 10 })
  }

  /** å•é€‰é¢˜ */
  @Builder
  buildSingleQuestion(): void {
    Column() {
      ForEach(this.question.options, (opt: EvaluationOption) => {
        Row() {
          Text(this.question.answer === opt.id ? 'ğŸ”˜' : 'âšª')
            .fontSize(16)
            .margin({ right: 8 })
          Text(opt.label)
            .fontSize(13)
            .fontColor('#334155')
        }
        .width('100%')
        .padding({ top: 8, bottom: 8 })
        .onClick(() => {
          this.question.answer = opt.id;
        })
      })
    }
    .width('100%')
  }

  /** å¤šé€‰é¢˜ */
  @Builder
  buildMultiQuestion(): void {
    Column() {
      ForEach(this.question.options, (opt: EvaluationOption) => {
        Row() {
          Text(this.isOptionSelected(opt.id) ? 'â˜‘' : 'â˜')
            .fontSize(16)
            .margin({ right: 8 })
          Text(opt.label)
            .fontSize(13)
            .fontColor('#334155')
        }
        .width('100%')
        .padding({ top: 8, bottom: 8 })
        .onClick(() => this.toggleOption(opt.id))
      })
    }
    .width('100%')
  }

  /** æ˜Ÿçº§è¯„åˆ† */
  @Builder
  buildStarQuestion(): void {
    Row() {
      ForEach([1, 2, 3, 4, 5], (star: number) => {
        Text(star <= (this.question.answer as number || 0) ? 'â˜…' : 'â˜†')
          .fontSize(28)
          .fontColor(star <= (this.question.answer as number || 0) ? '#F59E0B' : '#CBD5E1')
          .margin({ right: 8 })
          .onClick(() => {
            this.question.answer = star;
          })
      })
    }
    .width('100%')
    .padding({ top: 4, bottom: 4 })
  }

  /** ä¸»è§‚é¢˜ */
  @Builder
  buildTextQuestion(): void {
    TextArea({ placeholder: 'è¯·è¾“å…¥æ‚¨çš„æ„è§...' })
      .width('100%')
      .height(100)
      .fontSize(13)
      .backgroundColor('#F8FAFC')
      .borderRadius(8)
      .padding(10)
      .onChange((val: string) => {
        this.question.answer = val;
      })
  }

  /** åˆ¤æ–­å¤šé€‰é€‰é¡¹æ˜¯å¦é€‰ä¸­ */
  private isOptionSelected(optionId: string): boolean {
    const answer = this.question.answer as string[];
    return answer ? answer.includes(optionId) : false;
  }

  /** åˆ‡æ¢å¤šé€‰é€‰é¡¹ */
  private toggleOption(optionId: string): void {
    const current = this.question.answer as string[];
    const answer: string[] = current ? current.slice() : [];
    const pos = answer.indexOf(optionId);
    if (pos >= 0) {
      answer.splice(pos, 1);
    } else {
      answer.push(optionId);
    }
    this.question.answer = answer;
  }
}
