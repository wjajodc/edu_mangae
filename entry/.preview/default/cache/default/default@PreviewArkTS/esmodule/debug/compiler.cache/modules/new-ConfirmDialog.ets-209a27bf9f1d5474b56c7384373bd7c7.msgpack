@Component
export struct ConfirmDialog {
  /** å¼¹çª—æ ‡é¢˜ */
  @Prop title: string = 'æç¤º';
  /** å¼¹çª—å†…å®¹ */
  @Prop content: string = '';
  /** æ˜¯å¦æ˜¾ç¤º */
  @Link visible: boolean;
  /** ç¡®è®¤æŒ‰é’®æ–‡æ¡ˆ */
  @Prop confirmText: string = 'ç¡®å®š';
  /** å–æ¶ˆæŒ‰é’®æ–‡æ¡ˆ */
  @Prop cancelText: string = 'å–æ¶ˆ';
  /** ç¡®è®¤å›è°ƒ */
  onConfirm?: () => void;
  /** å–æ¶ˆå›è°ƒ */
  onCancel?: () => void;

  build() {
    if (this.visible) {
      Column() {
        // é®ç½©å±‚
        Column()
          .width('100%')
          .height('100%')
          .backgroundColor('rgba(15, 23, 42, 0.45)')
          .onClick(() => {
            this.visible = false;
            if (this.onCancel) {
              this.onCancel();
            }
          })

        // å¼¹çª—å¡ç‰‡
        Column() {
          // æ ‡é¢˜
          Text(this.title)
            .fontSize(17)
            .fontWeight(FontWeight.Bold)
            .fontColor('#0F172A')
            .textAlign(TextAlign.Center)
            .width('100%')
            .margin({ bottom: 12 })

          // å†…å®¹
          Text(this.content)
            .fontSize(14)
            .fontColor('#475569')
            .textAlign(TextAlign.Center)
            .width('100%')
            .margin({ bottom: 20 })

          // æ“ä½œæŒ‰é’®
          Row() {
            Button(this.cancelText)
              .type(ButtonType.Normal)
              .layoutWeight(1)
              .height(44)
              .fontSize(14)
              .fontWeight(FontWeight.Medium)
              .fontColor('#0F172A')
              .backgroundColor('#F1F5F9')
              .borderRadius(10)
              .onClick(() => {
                this.visible = false;
                if (this.onCancel) {
                  this.onCancel();
                }
              })

            Button(this.confirmText)
              .type(ButtonType.Normal)
              .layoutWeight(1)
              .height(44)
              .fontSize(14)
              .fontWeight(FontWeight.Medium)
              .fontColor('#FFFFFF')
              .backgroundColor('#2563EB')
              .borderRadius(10)
              .margin({ left: 12 })
              .onClick(() => {
                this.visible = false;
                if (this.onConfirm) {
                  this.onConfirm();
                }
              })
          }
          .width('100%')
        }
        .width('80%')
        .padding(24)
        .backgroundColor('#FFFFFF')
        .borderRadius(16)
        .position({ left: '10%', bottom: 180 })
      }
      .width('100%')
      .height('100%')
      .position({ x: 0, y: 0 })
      .zIndex(100)
    }
  }
}
