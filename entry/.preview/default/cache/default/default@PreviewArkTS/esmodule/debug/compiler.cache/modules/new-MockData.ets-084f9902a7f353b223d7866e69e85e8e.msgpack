/** æ¼”ç¤ºç™»å½•å­¦å·åˆ—è¡¨ */
export function isValidStudentId(studentId: string): boolean {
  return studentId === '2024316020318' || studentId === '2024316020320' || studentId === 'demo';
}

/** æ¼”ç¤ºç™»å½•å¯†ç éªŒè¯ */
export function validatePassword(studentId: string, password: string): boolean {
