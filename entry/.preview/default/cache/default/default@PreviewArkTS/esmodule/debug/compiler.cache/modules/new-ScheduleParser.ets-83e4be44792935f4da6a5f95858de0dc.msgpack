        return result;
    }
    static calcMaxWeek(entries) {
        let maxWeek = 18;
        for (let i = 0; i < entries.length; i++) {
            const weeks = entries[i].weeks;
            for (let j = 0; j < weeks.length; j++) {
                if (weeks[j] > maxWeek) {
                    maxWeek = weeks[j];
                }
            }
        }
        return maxWeek;
    }
}
