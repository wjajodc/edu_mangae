                        courseCode: block.courseCode,
                        courseName: block.courseName,
                        teacher: block.teacher,
                        classroom: block.classroom,
                        dayOfWeek: day + 1,
                        startPeriod: period,
                        endPeriod: period + span - 1,
                        span: span,
                        weeks: block.weeks,
                        weekRangeText: block.weekRangeText,
                    };
