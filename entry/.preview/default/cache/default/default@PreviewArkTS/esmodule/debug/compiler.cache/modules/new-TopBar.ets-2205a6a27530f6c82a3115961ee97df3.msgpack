 * æ”¯æŒæ ‡é¢˜ã€è¿”å›æŒ‰é’®ã€å³ä¾§æ“ä½œæŒ‰é’®ã€é€æ˜æ¯›ç»ç’ƒæ•ˆæœ
 */
@Component
export struct TopBar {
  /** æ ‡é¢˜æ–‡å­— */
  @Prop title: string = 'æ•™å­¦ç®¡ç†ç³»ç»Ÿ';
  /** æ˜¯å¦æ˜¾ç¤ºè¿”å›æŒ‰é’® */
  @Prop showBack: boolean = false;
  /** å³ä¾§æ–‡å­—æŒ‰é’®ï¼ˆå¦‚"é€€å‡º"ï¼‰ */
  @Prop rightText: string = '';
  /** è¿”å›ç‚¹å‡»å›è°ƒ */
  onBack?: () => void;
  /** å³ä¾§æŒ‰é’®ç‚¹å‡»å›è°ƒ */
  onRightClick?: () => void;

  build() {
    Row() {
      // è¿”å›æŒ‰é’®åŒºåŸŸ
      if (this.showBack) {
        Button() {
          Text('â†').fontSize(22).fontWeight(FontWeight.Bold)
        }
        .type(ButtonType.Normal)
        .backgroundColor(Color.Transparent)
        .width(40)
        .height(40)
        .borderRadius(10)
        .fontColor('#2563EB')
        .onClick(() => {
          if (this.onBack) {
            this.onBack();
          }
        })
      } else {
        // å ä½ä¿æŒæ ‡é¢˜å±…ä¸­
        Row().width(40).height(40)
      }

      // æ ‡é¢˜
      Text(this.title)
        .fontSize(18)
        .fontWeight(FontWeight.Bold)
        .fontColor('#0F172A')
        .textAlign(TextAlign.Center)
        .layoutWeight(1)

      // å³ä¾§æŒ‰é’®
      if (this.rightText && this.rightText.length > 0) {
        Button(this.rightText)
          .type(ButtonType.Normal)
          .backgroundColor(Color.Transparent)
          .fontSize(13)
          .fontWeight(600)
          .fontColor('#64748B')
          .padding({ left: 10, right: 10 })
          .width(56)
          .height(40)
          .borderRadius(10)
          .onClick(() => {
            if (this.onRightClick) {
              this.onRightClick();
            }
          })
      } else {
        Row().width(40).height(40)
      }
    }
    .width('100%')
    .height(56)
    .padding({ left: 14, right: 14 })
    .backgroundColor('rgba(255, 255, 255, 0.92)')
    .backdropBlur(10)
    .borderWidth({ bottom: 1 })
    .borderColor('#E2E8F0')
    .alignItems(VerticalAlign.Center)
  }
}
