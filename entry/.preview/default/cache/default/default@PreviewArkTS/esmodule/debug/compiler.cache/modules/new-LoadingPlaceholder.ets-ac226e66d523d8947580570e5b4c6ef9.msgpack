@Component
export struct LoadingPlaceholder {
  /** æç¤ºæ–‡å­— */
  @Prop message: string = 'åŠ è½½ä¸­...';
  /** æ˜¯å¦å…¨å±å±…ä¸­ */
  @Prop fullScreen: boolean = true;

  build() {
    Column() {
      // æ—‹è½¬åŠ¨ç”»æŒ‡ç¤ºå™¨
      LoadingProgress()
        .width(36)
        .height(36)
        .color('#2563EB')

      Text(this.message)
        .fontSize(14)
        .fontColor('#64748B')
        .margin({ top: 12 })
    }
    .width('100%')
    .height(this.fullScreen ? '60%' : 'auto')
    .justifyContent(FlexAlign.Center)
    .alignItems(HorizontalAlign.Center)
    .padding({ top: this.fullScreen ? 60 : 24, bottom: 24 })
  }
}

/**
 * åˆ—è¡¨åŠ è½½æ›´å¤šå ä½ï¼ˆåº•éƒ¨åŠ è½½æŒ‡ç¤ºå™¨ï¼‰
 */
@Component
export struct LoadMoreIndicator {
  @Prop hasMore: boolean = true;
  @Prop loadingText: string = 'åŠ è½½ä¸­...';
  @Prop noMoreText: string = 'â€” æ²¡æœ‰æ›´å¤šäº† â€”';

  build() {
    Row() {
      if (this.hasMore) {
        LoadingProgress()
          .width(16)
          .height(16)
          .color('#2563EB')
        Text(this.loadingText)
          .fontSize(12)
          .fontColor('#64748B')
          .margin({ left: 8 })
      } else {
        Text(this.noMoreText)
          .fontSize(12)
          .fontColor('#94A3B8')
      }
    }
    .width('100%')
    .justifyContent(FlexAlign.Center)
    .padding({ top: 16, bottom: 16 })
  }
}
