    async loadGrades() {
        this.isLoading = true;
        await new Promise((r) => setTimeout(r, 500));
        // æ ¹æ®å­¦æœŸåŠ è½½æ•°æ®
        if (this.currentSemester === '2025-2026 ç¬¬1å­¦æœŸ') {
            this.grades = MOCK_GRADES_CURRENT;
        }
        else if (this.currentSemester === '2024-2025 ç¬¬2å­¦æœŸ') {
            this.grades = MOCK_GRADES_HISTORY;
        }
        else if (this.currentSemester === '2025-2026 ç¬¬2å­¦æœŸ') {
            this.grades = MOCK_GRADES_UNPUBLISHED;
        }
        else {
            this.grades = [];
        }
        this.isLoading = false;
    }
    /** è®¡ç®—å­¦æœŸæ±‡æ€» */
    getSummary() {
        const emptySummary = { totalCredit: 0, avgGpa: 0 };
        if (!this.grades || this.grades.length === 0) {
            return emptySummary;
        }
        const published = this.grades.filter((g) => g.isPublished);
        if (published.length === 0) {
            return emptySummary;
        }
        const totalCredit = published.reduce((sum, g) => sum + (g.credit || 0), 0);
        const totalGpa = published.reduce((sum, g) => sum + (g.gpa || 0) * (g.credit || 0), 0);
        const avgGpa = totalCredit > 0 ? parseFloat((totalGpa / totalCredit).toFixed(2)) : 0;
        const summary = { totalCredit: totalCredit, avgGpa: avgGpa };
        return summary;
    }
