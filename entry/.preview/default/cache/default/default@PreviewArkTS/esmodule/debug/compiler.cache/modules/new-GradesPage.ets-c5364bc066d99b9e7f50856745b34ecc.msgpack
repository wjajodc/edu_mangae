import { router } from '@kit.ArkUI';
import { TopBar } from '../components/TopBar';
import { LoadingPlaceholder } from '../components/LoadingPlaceholder';
import { EmptyPlaceholder } from '../components/EmptyPlaceholder';
import { MOCK_GRADES_CURRENT, MOCK_GRADES_HISTORY, MOCK_GRADES_UNPUBLISHED, SEMESTER_OPTIONS } from '../mock/MockData';
import { GradeRecord, SemesterSummary } from '../model/GradeModel';

@Entry
@Component
export struct GradesPage {
  /** æ˜¯å¦ä½œä¸º Tab åµŒå…¥ä¸»æ¡†æ¶ï¼ˆåµŒå…¥æ—¶éšè—è¿”å›æŒ‰é’®ï¼‰ */
  @Prop embedded: boolean = false;
  @State currentSemester: string = '2025-2026 ç¬¬1å­¦æœŸ';
  @State grades: GradeRecord[] = [];
  @State isLoading: boolean = true;
  @State showSubScore: boolean = false;
  @State selectedGrade: GradeRecord | null = null;

  aboutToAppear(): void {
    this.loadGrades();
  }

  private async loadGrades(): Promise<void> {
    this.isLoading = true;
    await new Promise<void>((r) => setTimeout(r, 500));
    // æ ¹æ®å­¦æœŸåŠ è½½æ•°æ®
    if (this.currentSemester === '2025-2026 ç¬¬1å­¦æœŸ') {
      this.grades = MOCK_GRADES_CURRENT;
    } else if (this.currentSemester === '2024-2025 ç¬¬2å­¦æœŸ') {
      this.grades = MOCK_GRADES_HISTORY;
    } else if (this.currentSemester === '2025-2026 ç¬¬2å­¦æœŸ') {
      this.grades = MOCK_GRADES_UNPUBLISHED;
    } else {
      this.grades = [];
    }
    this.isLoading = false;
  }

  /** è®¡ç®—å­¦æœŸæ±‡æ€» */
  private getSummary(): SemesterSummary {
    const emptySummary: SemesterSummary = { totalCredit: 0, avgGpa: 0 };
    if (!this.grades || this.grades.length === 0) {
      return emptySummary;
    }
    const published = this.grades.filter((g: GradeRecord) => g.isPublished);
    if (published.length === 0) {
      return emptySummary;
    }
    const totalCredit = published.reduce((sum: number, g: GradeRecord) => sum + (g.credit || 0), 0);
    const totalGpa = published.reduce((sum: number, g: GradeRecord) => sum + (g.gpa || 0) * (g.credit || 0), 0);
    const avgGpa = totalCredit > 0 ? parseFloat((totalGpa / totalCredit).toFixed(2)) : 0;
    const summary: SemesterSummary = { totalCredit: totalCredit, avgGpa: avgGpa };
    return summary;
  }

  build() {
    Stack() {
      Column() {
        TopBar({
          title: 'æˆç»©æŸ¥è¯¢',
          showBack: !this.embedded,
          onBack: () => router.back()
        })

        if (this.isLoading) {
          LoadingPlaceholder()
        } else {
          Scroll() {
            Column() {
              // å­¦æœŸé€‰æ‹©å™¨
              this.buildSemesterSelector()

              // æ±‡æ€»ç»Ÿè®¡
              this.buildSummary()

              // æˆç»©åˆ—è¡¨
              Column() {
                if (this.grades.length === 0) {
                  EmptyPlaceholder({
                    message: 'æš‚æœªå‘å¸ƒ',
                    subMessage: 'å½“å‰å­¦æœŸæš‚æ— å·²å‘å¸ƒçš„æˆç»©',
                    iconText: 'ğŸ“Š'
                  })
                } else {
                  ForEach(this.grades, (grade: GradeRecord) => {
                    GradeCard({
                      grade: grade,
                      onTap: () => {
                        if (grade.isPublished && grade.subScores) {
                          this.selectedGrade = grade;
                          this.showSubScore = true;
                        }
                      }
                    })
                  })
                }
              }
              .width('100%')
              .padding({ left: 14, right: 14 })

              Column().height(24)
            }
            .width('100%')
          }
          .width('100%')
          .layoutWeight(1)
          .scrollBar(BarState.Off)
        }
      }
      .width('100%')
      .height('100%')
      .backgroundColor('#EEF2F8')

      // åˆ†é¡¹æˆç»©å¼¹çª—
      if (this.showSubScore && this.selectedGrade) {
        this.buildSubScoreSheet()
      }
    }
  }

  @Builder
  buildSemesterSelector(): void {
    Row() {
      Scroll() {
        Row() {
          ForEach(SEMESTER_OPTIONS, (sem: string) => {
            Text(sem)
              .fontSize(12)
              .fontWeight(600)
              .fontColor(this.currentSemester === sem ? '#FFFFFF' : '#2563EB')
              .backgroundColor(this.currentSemester === sem ? '#2563EB' : '#FFFFFF')
              .borderRadius(8)
              .borderWidth(1)
              .borderColor('#2563EB')
              .padding({ left: 12, right: 12, top: 6, bottom: 6 })
              .margin({ right: 8 })
              .onClick(() => {
                this.currentSemester = sem;
                this.loadGrades();
              })
          })
        }
      }
      .scrollable(ScrollDirection.Horizontal)
      .scrollBar(BarState.Off)
    }
    .width('100%')
    .padding({ left: 14, top: 12, bottom: 6 })
  }

  @Builder
  buildSummary(): void {
    Row() {
      Column() {
        Text('æ€»å­¦åˆ†')
          .fontSize(11)
          .fontColor('#64748B')
        Text(String(this.getSummary().totalCredit))
          .fontSize(22)
          .fontWeight(FontWeight.Bold)
          .fontColor('#2563EB')
          .margin({ top: 2 })
      }
      .layoutWeight(1)
      .alignItems(HorizontalAlign.Center)

      Column() {
        Text('å¹³å‡ç»©ç‚¹')
          .fontSize(11)
          .fontColor('#64748B')
        Text(String(this.getSummary().avgGpa))
          .fontSize(22)
          .fontWeight(FontWeight.Bold)
          .fontColor('#EA580C')
          .margin({ top: 2 })
      }
      .layoutWeight(1)
      .alignItems(HorizontalAlign.Center)
    }
    .width('100%')
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .margin({ left: 14, right: 14, top: 8, bottom: 12 })
  }

  @Builder
  buildSubScoreSheet(): void {
    Column() {
      Column()
        .width('100%')
        .layoutWeight(1)
        .backgroundColor('rgba(15, 23, 42, 0.45)')
        .onClick(() => { this.showSubScore = false; })

      Column() {
        Row() {
          Text('åˆ†é¡¹æˆç»©')
            .fontSize(17)
            .fontWeight(FontWeight.Bold)
          Blank()
          Text('âœ•').fontSize(18).fontColor('#64748B')
            .onClick(() => { this.showSubScore = false; })
        }
        .width('100%')
        .margin({ bottom: 16 })

        if (this.selectedGrade) {
          Text(this.selectedGrade.courseName)
            .fontSize(16).fontWeight(FontWeight.Medium).margin({ bottom: 16 })

          Row() {
            SubScoreItem({ label: 'å¹³æ—¶æˆç»©', score: this.selectedGrade.subScores?.regular ?? null })
            SubScoreItem({ label: 'æœŸä¸­è€ƒè¯•', score: this.selectedGrade.subScores?.midterm ?? null })
          }.width('100%').justifyContent(FlexAlign.SpaceAround).margin({ bottom: 12 })

          Row() {
            SubScoreItem({ label: 'æœŸæœ«è€ƒè¯•', score: this.selectedGrade.subScores?.final ?? null })
            SubScoreItem({ label: 'å®éªŒ', score: this.selectedGrade.subScores?.experiment ?? null })
          }.width('100%').justifyContent(FlexAlign.SpaceAround)
        }
      }
      .width('100%')
      .padding(24)
      .backgroundColor('#FFFFFF')
      .borderRadius({ topLeft: 18, topRight: 18 })
    }
    .width('100%').height('100%').position({ x: 0, y: 0 }).zIndex(50)
  }
}

