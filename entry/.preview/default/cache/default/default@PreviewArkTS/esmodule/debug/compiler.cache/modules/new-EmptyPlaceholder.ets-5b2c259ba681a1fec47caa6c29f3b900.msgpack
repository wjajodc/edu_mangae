@Component
export struct EmptyPlaceholder {
  /** æç¤ºæ–‡å­— */
  @Prop message: string = 'æš‚æ— æ•°æ®';
  /** å‰¯æç¤ºæ–‡å­— */
  @Prop subMessage: string = '';
  /** æ˜¯å¦æ˜¾ç¤ºæ“ä½œæŒ‰é’® */
  @Prop showAction: boolean = false;
  /** æ“ä½œæŒ‰é’®æ–‡å­— */
  @Prop actionText: string = 'åˆ·æ–°';
  /** å›¾æ ‡æ–‡å­— */
  @Prop iconText: string = 'ğŸ“­';

  /** æ“ä½œæŒ‰é’®ç‚¹å‡»å›è°ƒ */
  onAction?: () => void;

  build() {
    Column() {
      // å›¾æ ‡
      Text(this.iconText)
        .fontSize(48)
        .margin({ bottom: 16 })

      // ä¸»æç¤º
      Text(this.message)
        .fontSize(16)
        .fontWeight(FontWeight.Medium)
        .fontColor('#0F172A')
        .margin({ bottom: 6 })

      // å‰¯æç¤º
      if (this.subMessage && this.subMessage.length > 0) {
        Text(this.subMessage)
          .fontSize(13)
          .fontColor('#64748B')
          .textAlign(TextAlign.Center)
          .maxLines(2)
      }

      // æ“ä½œæŒ‰é’®
      if (this.showAction) {
        Button(this.actionText)
          .type(ButtonType.Normal)
          .backgroundColor('#2563EB')
          .fontColor(Color.White)
          .fontSize(14)
          .fontWeight(600)
          .borderRadius(10)
          .padding({ left: 24, right: 24, top: 10, bottom: 10 })
          .margin({ top: 20 })
          .onClick(() => {
            if (this.onAction) {
              this.onAction();
            }
          })
      }
    }
    .width('100%')
    .justifyContent(FlexAlign.Center)
    .alignItems(HorizontalAlign.Center)
    .padding({ top: 80, bottom: 40, left: 24, right: 24 })
  }
}

